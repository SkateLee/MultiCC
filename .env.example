# Choose ONE provider configuration and replace the placeholders.
# The model variable read by the CLI is MODEL.

# OpenAI-compatible endpoint
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://your-provider.example/v1
MODEL=your-model-name

# Anthropic native endpoint (comment out the OpenAI configuration above)
# ANTHROPIC_API_KEY=your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# MODEL=your-model-name

# Generic aliases (use instead of the provider-specific key/base variables)
# APIKEY=your-api-key
# API=https://your-provider.example/v1
# MODEL=your-model-name
# Use an /anthropic endpoint only when the provider supports that protocol.

# multiCC-specific aliases (use instead of the generic or provider-specific variables)
# MULTICC_API_KEY=your-api-key
# MULTICC_API_BASE=https://your-provider.example/v1
# MODEL=your-model-name

# Optional online Skill evolution (enabled by default)
# MULTICC_AUTO_SKILL_EVOLUTION=1
# MULTICC_AUTO_SKILL_TARGET=project
